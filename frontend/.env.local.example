# Point this at the running FastAPI backend to enable real auth, submissions,
# mastery and stats. Leave UNSET to keep the UI in offline / demo mode (every
# call falls back to local behaviour and no network requests are made).
#
# Local dev:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Deployed:
#   NEXT_PUBLIC_API_URL=https://adaptcode-api.yourdomain.com
NEXT_PUBLIC_API_URL=
